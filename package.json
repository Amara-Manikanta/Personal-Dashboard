{
  "name": "novels-dashboard-server",
  "version": "1.0.0",
  "description": "File based server for Novels Dashboard",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "mac": "electron .",
    "electron:dev": "electron .",
    "pack:mac": "electron-builder --mac dir",
    "dist:mac": "electron-builder --mac dmg"
  },
  "dependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "open-graph-scraper": "^6.11.0"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "nodemon": "^3.1.0"
  },
  "build": {
    "appId": "com.amara.lifestudio",
    "productName": "LifeStudio",
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.lifestyle",
      "icon": "electron/assets/icon.icns",
      "target": [
        "dir"
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "files": [
      "**/*",
      "!raw_stamps/**/*",
      "!raw_stamps_jpg/**/*",
      "!previews/**/*",
      "!untitled folder/**/*",
      "!dist/**/*"
    ]
  }
}
